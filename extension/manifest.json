{
  "manifest_version": 3,
  "name": "AutoDL Grab 本地连接",
  "description": "用选中的 AutoDL 标签页为本地工作台提供只读市场查询。",
  "version": "1.0.0",
  "key": "",
  "action": {"default_title": "连接当前 AutoDL 标签页"},
  "background": {"service_worker": "worker.js"},
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"]
}
